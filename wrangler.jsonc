{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sleepy",
  "compatibility_date": "2026-09-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "sleepy.hexly.ai", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
